ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=120
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=120
GEMINI_TEMPERATURE=0.4
AI_ANALYSIS_MODE=claude-code
AI_ANALYSIS_STRICT=false
PYDANTIC_DISABLE_PLUGINS=__all__
REPORT_DOWNLOAD_IMAGES=false
REPORT_IMAGE_TIMEOUT_SECONDS=3
MAX_RESULTS_PER_SOURCE=30
SEARCH_MAX_PAGES=5
SEARCH_DETAIL_MULTIPLIER=2
# Early exit listing pagination: po N kolejnych pustych stronach przerwij
# (oszczędza ~30s/strona dla rzadkich modeli z 0/mało wyników).
SEARCH_EMPTY_STREAK_THRESHOLD=2
# Parallel detail-fetch (sem). AHB jest CDP+cache (HIT ~1ms, connect ~0.3s),
# więc 5 jest bezpieczne. Przy throttle AHB/Imperva wróć do 3.
IAAI_PARALLEL_DETAIL=5
COPART_PARALLEL_DETAIL=5
# === Detail page wait tuning (BEZWARUNKOWO na każdy lot — główny bottleneck) ===
# Niższe = szybciej, ale za krótko = utracone dane lazy-load. Gdy braki
# (VIN/damage/images) → zwiększ DETAIL_SETTLE_WAIT_S (i ew. DETAIL_NETWORKIDLE_MS).
DETAIL_NETWORKIDLE_MS=6000
DETAIL_SCROLL_WAIT_S=0.8
DETAIL_SETTLE_WAIT_S=1.0
# Listing: wait po nav (IAAI) + settle po kliknięciu paginacji.
IAAI_LISTING_INITIAL_WAIT_S=3
PAGINATION_SETTLE_S=1
# === AHB on-disk cache (60-day TTL per {source}:lot_id) ===
# 2nd scrape tego samego lota w oknie TTL = instant cache HIT (~15-20s/lot saved).
# Persistent JSON w data/ahb_cache.json — best-effort, błędy nie blokują scrape.
AHB_CACHE_ENABLED=true
AHB_CACHE_PATH=data/ahb_cache.json
AHB_CACHE_TTL_DAYS=60
EXTENSION_IFRAME_WAIT_SECONDS=8
AUTOHELPERBOT_DIRECT_WAIT_SECONDS=8
STRICT_SCAN_MAX_RESULTS_THRESHOLD=3
HEADLESS=true
SLOW_MO_MS=1500
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
LOGIN_NAV_TIMEOUT_MS=15000
DETAIL_NAV_TIMEOUT_MS=60000
EXTENSION_IFRAME_WAIT_SECONDS=15
AUTOHELPERBOT_DIRECT_WAIT_SECONDS=20
AUTOHELPERBOT_DIRECT_ENABLED=true
# === AHB CDP attach (bypass Cloudflare challenge) ===
# AHB.com zaostrzyło CF protection — headless scrape dostaje "security
# verification" zamiast danych. Rozwiązanie: headed Chrome (./bidfax_chrome_debug.sh)
# gdzie user klika CF Turnstile RAZ na autohelperbot.com, backend łączy się
# przez CDP do tej cleared sesji. Reuse tej samej Chrome co bidfax — gdy puste,
# fallback do BIDFAX_CHROME_CDP_URL. Pusto = stary headless (CF-blocked) flow.
AHB_CHROME_CDP_URL=
# Auto-warmup: gdy AHB zwróci CF challenge mimo CDP, backend sam nawiguje
# homepage AHB (real Chrome auto-passa CF), czeka max N sekund aż interstitial
# zniknie i ponawia lota — bez ręcznej interwencji. Lock+30s throttle przy
# parallel. 0 = wyłącz auto-warmup (stary fast-fail).
AHB_CF_WARMUP_SECONDS=25
AUTOHELPERBOT_POST_LOGIN_WAIT_SECONDS=5
AUTOHELPERBOT_SECURITY_WAIT_SECONDS=20
BLOCK_MEDIA_ASSETS=false
HTML_CACHE_DIR=./data/html_cache
REPORTS_DIR=./data/reports
APP_DATABASE_PATH=./data/app.db
CHROME_PROFILE_DIR=./data/chromium_profile
# MUSI zostać chromium gdy USE_EXTENSIONS=true: Google Chrome od 137 ignoruje
# --load-extension i wtyczki po cichu się nie ładują (sprawdzone na Chrome 151:
# chrome-extension://<id>/popup/index.html -> ERR_BLOCKED_BY_CLIENT).
BROWSER_CHANNEL=chromium
BROWSER_EXECUTABLE_PATH=
BROWSER_LAUNCH_TIMEOUT_MS=90000
USE_EXTENSIONS=false
KEEP_BROWSER_OPEN=true
DISABLED_EXTENSIONS=auctiongate
USE_MOCK_DATA=false
FILTER_SELLER_INSURANCE_ONLY=false
FORCE_REFRESH=true
CACHE_MAX_AGE_HOURS=24
MIN_AUCTION_WINDOW_HOURS=12
MAX_AUCTION_WINDOW_HOURS=168
ORCHESTRATOR_MAX_RESULTS=10
# Ile ofert dostaje klient po wypelnieniu formularza. Cztery to sufit: wiecej
# pozycji paralizuje wybor, mniej wyglada na brak oferty. Ranking odrzuca loty
# ponizej progu jakosci, wiec realnie bywa ich trzy.
CLIENT_OFFERS_COUNT=4
COPART_ACTIVE_LOGIN=true
COPART_POST_LOGIN_WAIT_SECONDS=10
COPART_SECURITY_WAIT_SECONDS=10
IAAI_ACTIVE_LOGIN=true
IAAI_POST_LOGIN_WAIT_SECONDS=10

# === MANHEIM (sesja z wtyczki BidWise) ===
# Manheim wymaga konta dealerskiego i loguje przez OTP — nie da się tego zrobić
# loginem/hasłem jak w Copart/IAAI. Sesję trzyma wtyczka BidWise (Eridan).
# Manheim nie zależy od USE_EXTENSIONS/HEADLESS — ma własną przeglądarkę.
# Wymagane RAZEM:
#   MANHEIM_BACKEND_ENABLED=true
#   + MANHEIM_CHROME_CDP_URL wskazujący Chrome z scripts/manheim_chrome_debug.sh,
#     w którym BidWise jest zainstalowana ze Web Store i zalogowana.
# Gdy czegoś brakuje, /api/capabilities zgłasza manheim jako unavailable
# (reason: manheim_session_not_configured) i scraper nie rusza.
MANHEIM_BACKEND_ENABLED=false
# ZALECANA (i jedyna sprawdzona) droga: Chrome operatora z BidWise ze Web Store,
# odpalony przez scripts/manheim_chrome_debug.sh, podpięty po CDP.
# Powód: BidWise wczytana jako unpacked (--load-extension) wyłącza SAMA SIEBIE
# po kilku sekundach (state=0, disable_reasons=1 — ma uprawnienie `management`),
# a Chrome >=137 i tak ignoruje --load-extension.
MANHEIM_CHROME_CDP_URL=
# Fallback gdy CDP puste: własny headed Chromium z rozpakowaną wtyczką.
MANHEIM_CHROME_PROFILE_DIR=./data/chrome_profile_manheim
# 0 = bez sztucznych opóźnień. Globalne SLOW_MO_MS (1500) potrafi rozwlec
# wyszukiwanie Manheima do kilku minut, dlatego ma własne pokrętło.
MANHEIM_SLOW_MO_MS=0
# Ile lotów Manheim oddaje na wyszukiwanie. Źródło uzupełniające — domyślnie TOP 3.
MANHEIM_MAX_RESULTS=3
MANHEIM_EXTENSION_DIR=./extensions/bidwise
MANHEIM_SEARCH_URL=https://search.manheim.com/results
MANHEIM_NAV_TIMEOUT_MS=45000
# SPA Manheima dociąga wyniki asynchronicznie — czekamy na XHR-y, nie na selektory.
MANHEIM_BOOT_WAIT_SECONDS=8
MANHEIM_RESULTS_WAIT_SECONDS=12
MANHEIM_DETAIL_WAIT_SECONDS=6
# W trybie CDP domyślnie false: każda nowa karta manheim.com prowokuje BidWise
# do sprzątania kart i ponownej autoryzacji, a ta ma limit prób z 10-minutową
# karencją. Rekord z listy trafia do zapisanego dokumentu, więc parser ma komplet
# poza zdjęciami. true = odwiedzaj strony lotów (tylko gdy wiesz po co).
MANHEIM_FETCH_DETAILS=false
# OVE / Buy Now / Private Store nie mają terminu zakończenia aukcji. true =
# takie loty przechodzą przez filtr okna czasowego (inaczej Manheim zawsze da 0).
MANHEIM_IGNORE_AUCTION_WINDOW=true
# Manheim to rynek dealerski (seller_type zawsze "dealer"), wiec filtr
# FILTER_SELLER_INSURANCE_ONLY wycinalby go do zera. Domyslnie Manheim jest
# spod niego wyjety; true = stare, scisle ciecie (Manheim da wtedy 0 lotow).
MANHEIM_RESPECT_INSURANCE_FILTER=false
# >0 = przy braku sesji otwórz popup BidWise i czekaj tyle sekund na zalogowanie.
# Zwykły scrape musi mieć 0, inaczej job zawiesi się w oczekiwaniu na człowieka.
MANHEIM_LOGIN_WAIT_SECONDS=0
# === Kolektor w przegladarce (extensions/manheim-collector) ===
# Sesje Manheima trzyma BidWise przez chrome.debugger, a Chrome ma jeden slot
# debuggera na karte — podpiecie Playwrighta zamyka karte w ~5 s. Dlatego dane
# ida pushem ze strony, przez wlasne rozszerzenie, na /api/manheim/ingest.
# Osobny token, zeby rozszerzenie nie nosilo pelnego SCRAPER_API_TOKEN-a.
MANHEIM_INGEST_TOKEN=
# collector (domyslnie) = zrodlo czyta rekordy zebrane przez rozszerzenie.
# browser = stara sciezka Playwright/CDP; zostawiona tylko na wypadek gdyby
# BidWise przestala blokowac debugger. Dzis konczy sie zamknieciem karty.
MANHEIM_SOURCE_MODE=collector
# Ile czekac az rozszerzenie wykona zlecone wyszukiwanie. 0 = nie zlecaj,
# korzystaj tylko z tego co kolektor zebral przy recznych wyszukiwaniach.
MANHEIM_JOB_TIMEOUT_SECONDS=60
MANHEIM_JOB_TTL_SECONDS=120
# Po tylu sekundach wydane, a nieodeslane zadanie wraca do kolejki
# (service worker MV3 bywa usypiany w trakcie).
MANHEIM_JOB_LEASE_SECONDS=45
# Szablon zapytania podpatrzony przez kolektor. Trzymany na dysku, bo sama
# pamiec procesu ginie przy kazdym deployu i restarcie uslugi — a bez
# szablonu zlecenia padaja, dopoki ktos recznie nie wyszuka w przegladarce.
# Plik niesie naglowki autoryzacji strony, wiec zapisujemy go z prawami 0600.
MANHEIM_TEMPLATES_PATH=./data/manheim_templates.json
MANHEIM_INGEST_DIR=./data/manheim_ingest
MANHEIM_INGEST_TTL_MINUTES=30
# Ile ostatnich surowych paczek trzymac (diagnostyka ksztaltu API). 0 = zadnych.
MANHEIM_INGEST_KEEP_RAW=20
AUTOHELPERBOT_EMAIL=
AUTOHELPERBOT_PASSWORD=

# === TELEGRAM BOT (multi-user broadcast notifications) ===
# Token od @BotFather (komenda /newbot)
TELEGRAM_BOT_TOKEN=
# Kod zaproszenia. Brokerzy wpisują "/start KOD" do bota.
# Gdy puste — każdy z linkiem do bota może się zarejestrować (open mode).
TELEGRAM_INVITE_CODE=
# (opcjonalnie) Inline button "🔗 Otwórz w UI" w wiadomości — link do dashboardu/UI.
TELEGRAM_UI_BASE_URL=
# (opcjonalnie) Long-poll timeout w sekundach (default 30).
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_HTTP_TIMEOUT=30

# === LLM provider dla parsera wiadomości + hybrid raportów ===
# 'anthropic' (default, stabilny) lub 'gemini' (free tier, 15 RPM / 1500 RPD).
# Anthropic primary = brak 429, Gemini idzie do fallback gdy Anthropic nie zadziała.
LLM_REPORTS_PROVIDER=claude-code
# Fallback (gdy primary fails). Anthropic→Gemini lub odwrotnie.
LLM_REPORTS_FALLBACK_ANTHROPIC=true

# === COPART filtrowanie server-side (drastycznie zmniejsza liczbę requestów) ===
# FETI Run and Drive (CERT-D) — default true. Wycina ~95% lotów które nie odpalają.
COPART_FILTER_RUN_AND_DRIVE=true
# DMG exclusion (Flood/Fire) — opt-in. Best effort, sprawdź `total=` w logach.
COPART_FILTER_EXCLUDE_DAMAGE=false

# === IAAI DOM filtrowanie (opt-in: klika filtry UI przed scrapingiem) ===
IAAI_USE_DOM_FILTERS=false

# === Listing-level seller filter (skip detail-fetch dla dealer/unknown) ===
# Gdy FILTER_SELLER_INSURANCE_ONLY=true (lub criteria wymusza insurance_only):
# - true → odrzucamy DEALER i UNKNOWN już na liście (zero detail-fetch
#   dla lotów bez native badge / AHB chip — oszczędza ~10-20s/lot).
# - false → odrzucamy tylko DEALER; UNKNOWN przepuszczamy do detail page.
# UWAGA: IAAI native badge nie jest niezawodnie widoczny w listing HTML
# (React/lazy render), więc IAAI default = false (permissive). Włącz strict
# dopiero po weryfikacji w logach `[IAAI] Strona listy N: seller insurance=X`
# z X > 0. Copart `ifs` w JSON listing API jest zawsze obecny → safe strict.
IAAI_REQUIRE_LISTING_SELLER=false
COPART_REQUIRE_LISTING_SELLER=true

# === Frame damage vision check (Claude vision dla lotów z FRONT/REAR damage) ===
# Per lot z damage_primary zawierającym FRONT/REAR → Claude analizuje zdjęcia
# i sprawdza czy uszkodzona jest belka konstrukcyjna (auto-ODRZUĆ gdy tak).
# Cache 60 dni per VIN w data/frame_damage_cache.json.
# Koszt: ~$0.02 per lot (4 obrazy × 1.5k tokens vision input).
FRAME_DAMAGE_VISION_ENABLED=true
FRAME_DAMAGE_CACHE_PATH=data/frame_damage_cache.json
FRAME_DAMAGE_CACHE_TTL_DAYS=60
FRAME_DAMAGE_MAX_IMAGES=4

# === Bidfax (historyczne ceny sprzedaży) — default OFF ===
# Wymaga: AuctionGate extension (full_vin loty) + ręczny CF warmup co 1-7 dni
# + osobny Chrome na CDP porcie. Patrz bidfax_chrome_debug.sh.
BIDFAX_ENRICHMENT_ENABLED=false
# Gdy włączysz: np. http://localhost:9222 (lub http://<windows_ip>:9222 z WSL2)
BIDFAX_CHROME_CDP_URL=
BIDFAX_HEADLESS=false
BIDFAX_DEBUG_SCREENSHOTS=false
BIDFAX_CACHE_PATH=data/bidfax_cache.json
BIDFAX_CACHE_TTL_DAYS=60
BIDFAX_LOG_DIR=./logs
BIDFAX_CHROME_PROFILE_DIR=data/chrome_profile_bidfax

# === Claude Code jako dostawca modelu (subskrypcja, bez klucza API) ===
# Uwierzytelnienie idzie z sesji zalogowanego uzytkownika (`claude /login`), nie z
# ANTHROPIC_API_KEY — klucz w tym pliku nalezy do proxy oneprovider.dev i jest niewazny.
# Na serwerze trzeba byc zalogowanym jako uzytkownik, ktory uruchamia usluge.
# Weryfikacja: `sudo -u <uzytkownik-uslugi> claude -p --model haiku <<< "test"`.
# Dostawcy: AI_ANALYSIS_MODE (analiza lotow) i LLM_REPORTS_PROVIDER (raporty,
# parser wiadomosci) siedza wyzej w tym pliku — tu zostaje sama oferta.
OFFER_AGENT_AI_PROVIDER=claude-code
# Pusto = szukamy `claude` w PATH. Ustaw tylko gdy CLI stoi poza PATH uslugi.
CLAUDE_CLI_PATH=
# Modele per zadanie. Aliasy CLI (sonnet/opus/haiku) albo pelne identyfikatory.
# Analiza lotow — rozpoznanie szkod i opisy, tu jakosc sie oplaca.
CLAUDE_CODE_MODEL=sonnet
# Oferta — jedyny tekst, ktory czyta klient, jedno wywolanie na wyszukiwanie.
CLAUDE_CODE_OFFER_MODEL=sonnet
# Raporty per lot — wypelnianie schematu JSON o twardych limitach znakow.
CLAUDE_CODE_REPORTS_MODEL=haiku
CLAUDE_CODE_REPORTS_EFFORT=low
CLAUDE_CODE_TIMEOUT_SECONDS=300
CLAUDE_CODE_MAX_RETRIES=3
# Chunkowanie analizy. Prompt systemowy jest cache'owany, wiec kazde dodatkowe
# wywolanie kosztuje glownie start procesu (~1,5 s) — mniej, wiekszych chunkow jest
# szybsze. Przy bledzie parsowania kod sam ponawia chunk o polowe mniejszy.
CLAUDE_CODE_CHUNK_SIZE=8
CLAUDE_CODE_MAX_LOTS=15
CLAUDE_CODE_WORKDIR=
