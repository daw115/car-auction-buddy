[Unit]
Description=USA Car Finder — przeglądarka Manheim (Xvfb + Chrome + BidWise)
Documentation=file:///opt/usacar/usa-car-finder/extensions/manheim-collector/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dawid
WorkingDirectory=%h/usacar/usa-car-finder
Environment=MANHEIM_DISPLAY=:99
Environment=MANHEIM_VNC_PORT=5900
Environment=MANHEIM_CHROME_PROFILE_DIR=%h/.chrome-manheim-profile
ExecStart=/bin/bash %h/usacar/usa-car-finder/scripts/manheim-browser-run.sh

# Chrome potrafi paść (OOM, crash renderera), a bez niego Manheim milknie —
# sesja BidWise siedzi w profilu, więc restart jest bezobsługowy.
Restart=always
RestartSec=15

# Nie zabijaj procesów potomnych osobno: skrypt sam sprząta Xvfb/x11vnc w trapie.
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
